# ==============================================================================
# Virtual TES Gen0 — Environment Configuration
# Phase 5.9: Railway 24/7 Cloud Deployment
# ==============================================================================

# Runtime Environment (production | development | test)
APP_ENV=production
PORT=8000

# Production Database (Provided automatically by Railway PostgreSQL plugin)
# Format: postgresql://postgres:password@host:port/railway
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Worker Execution Mode (Keep False on WEB service; dedicated WORKER process runs app.worker)
RUN_IN_PROCESS_WORKER=false

# Market Provider Hierarchy
MARKET_PROVIDER=LITGRID
LITGRID_API_URL=https://openapi.litgrid.eu/v1/kategorijos/elektros-energijos-kainos/801
ELERING_API_URL=https://dashboard.elering.ee/api/nps/price
# ENTSOE_API_TOKEN=  # Optional quaternary fallback

# Timezone & Bidding Zone
TES_TIMEZONE=Europe/Vilnius
TES_BIDDING_ZONE=LT
TES_RESOLUTION_MINUTES=15
TES_LOG_LEVEL=INFO

# Security & Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# Authentication Enforcement (true in production; optional in dev/test)
AUTH_REQUIRED=true

# Admin Account (Full operational control: Start, Pause, Resume, Stop, Re-optimize, Reset)
DASHBOARD_USERNAME=admin
# Generate PBKDF2 hash with: python -m app.auth.cli hash <your-password>
DASHBOARD_PASSWORD_HASH=pbkdf2_sha256$100000$aa61038c4a0c12da0a50b1b05fcd3942$2ca762c4070c05d6c0b1895780ee5179c099b963d797b6f14faa59ea9d4814ab

# Viewer Account (Read-only investor/guest access: inspect metrics, prices, charts)
VIEWER_USERNAME=viewer
VIEWER_PASSWORD_HASH=pbkdf2_sha256$100000$1b32948cfbc83a15291da938092bc201$96d5e0f5dfca34346eb4407ea376a92ec21b5f1ec2f0b4d4554238e8cb573216

# --- Gen0 Physical Thermal Storage Parameters ---
TES_TES__CAPACITY_KWH=15.0
TES_TES__MAX_CHARGE_POWER_KW=9.0
TES_TES__MAX_DISCHARGE_POWER_KW=3.0
TES_TES__CHARGE_EFFICIENCY=0.95
TES_TES__DISCHARGE_EFFICIENCY=0.90
TES_TES__STANDING_LOSS_PERCENT_PER_DAY=2.0
TES_TES__SOC_MIN_PERCENT=10.0
TES_TES__SOC_MAX_PERCENT=100.0

# --- Site Parameters ---
TES_SITE__GRID_CONNECTION_LIMIT_KW=12.0
TES_SITE__OTHER_LOADS_KW=2.0
TES_SITE__PROCESS_HEAT_DEMAND_KW=1.5

# --- Tariff Parameters (EUR/MWh) ---
TES_TARIFF__SUPPLIER_MARKUP_EUR_MWH=0.0
TES_TARIFF__VARIABLE_GRID_FEE_EUR_MWH=0.0
TES_TARIFF__VARIABLE_TAX_EUR_MWH=0.0
